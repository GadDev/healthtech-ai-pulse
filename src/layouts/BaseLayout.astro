---
import { desks, deskKeys } from '../lib/categories';
import '../styles/global.css';
import '../styles/publication.css';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'HealthTech AI Pulse',
  description = 'What changed. What the evidence supports. What to investigate next.',
} = Astro.props;
const configured = Boolean(import.meta.env.SITE_URL);
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const isCategoryPage = path === '/categories/' || path.startsWith('/desks/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title === 'HealthTech AI Pulse' ? title : `${title} · HealthTech AI Pulse`}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    {!configured && <meta name="robots" content="noindex, follow" />}
    {configured && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="HealthTech Pulse" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="HealthTech AI Pulse" href="/rss.xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="edition-ribbon">
        <span data-current-date>Evidence before claims</span>
        <span>Independent healthcare AI news</span>
      </div>
      <div class="masthead">
        <a class="brand" href="/" aria-label="HealthTech AI Pulse, home">
          HealthTech AI Pulse
        </a>
        {path !== '/' && (
          <p>What changed · What the evidence supports · What to investigate next</p>
        )}
      </div>
      <nav class="desk-nav" aria-label="Publication navigation">
        <div class="desk-nav__inner">
          <a href="/" aria-current={path === '/' ? 'page' : undefined}>
            Latest
          </a>
          <details class="desk-nav__categories">
            <summary
              class="desk-nav__summary"
              data-active={isCategoryPage || undefined}
              aria-controls="category-navigation"
            >
              Categories
              <svg
                class="desk-nav__chevron"
                width="14"
                height="14"
                viewBox="0 0 16 16"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="m4 6 4 4 4-4"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </summary>
            <ul id="category-navigation" class="desk-nav__menu">
              <li class="desk-nav__overview">
                <a href="/categories/" aria-current={path === '/categories/' ? 'page' : undefined}>
                  All categories
                </a>
              </li>
              {deskKeys.map((key) => (
                <li>
                  <a
                    href={`/desks/${key}/`}
                    aria-current={path === `/desks/${key}/` ? 'page' : undefined}
                  >
                    {desks[key].title}
                  </a>
                </li>
              ))}
            </ul>
          </details>
          <a href="/pulse/" aria-current={path.startsWith('/pulse/') ? 'page' : undefined}>
            Editions
          </a>
          <a href="/methodology/" aria-current={path === '/methodology/' ? 'page' : undefined}>
            Methodology
          </a>
          <a href="/search/" aria-current={path === '/search/' ? 'page' : undefined}>
            Search
          </a>
        </div>
      </nav>
    </header>
    <main id="main" class="publication-main">
      <slot />
    </main>
    <footer class="publication-footer">
      <div class="footer-inner">
        <p class="footer-wordmark">HealthTech AI Pulse</p>
        <p>Evidence-led intelligence for people building and evaluating healthcare AI.</p>
        <nav aria-label="Footer navigation">
          <a href="/about/">About</a>
          <a href="/methodology/">Evidence & corrections</a>
          <a href="/contact/">Contact</a>
          <a href="/privacy/">Privacy</a>
          <a href="/rss.xml">RSS</a>
          <a href="https://github.com/GadDev/healthtech-ai-pulse">GitHub</a>
        </nav>
        <p class="fineprint">
          Research and industry intelligence. No personalised medical advice. Publication follows
          human review.
        </p>
      </div>
    </footer>
    <script>
      const categories = document.querySelector<HTMLDetailsElement>('.desk-nav__categories');
      const categoryTrigger = categories?.querySelector('summary');
      if (categories && categoryTrigger) {
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && categories.open) {
            event.preventDefault();
            categories.open = false;
            categoryTrigger.focus();
          }
        });
        document.addEventListener('click', (event) => {
          if (event.target instanceof Node && !categories.contains(event.target)) {
            categories.open = false;
          }
        });
        categories.addEventListener('focusout', (event) => {
          if (!(event.relatedTarget instanceof Node) || !categories.contains(event.relatedTarget)) {
            categories.open = false;
          }
        });
        categories.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', (event) => {
            if (
              event.defaultPrevented ||
              event.button !== 0 ||
              event.metaKey ||
              event.ctrlKey ||
              event.shiftKey ||
              event.altKey
            )
              return;
            categories.open = false;
          });
        });
      }
      const dateElement = document.querySelector('[data-current-date]');
      if (dateElement) {
        const formatter = new Intl.DateTimeFormat('en-GB', {
          weekday: 'long',
          day: 'numeric',
          month: 'long',
          year: 'numeric',
          timeZone: 'Europe/Luxembourg',
        });
        const updateDate = () => {
          dateElement.textContent = formatter.format(new Date());
        };
        updateDate();
        window.setInterval(updateDate, 60_000);
        document.addEventListener('visibilitychange', () => {
          if (!document.hidden) updateDate();
        });
      }
    </script>
  </body>
</html>
