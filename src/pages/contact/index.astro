---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact">
  <p class="eyebrow">Questions & corrections</p>
  <h1>Help us get it right.</h1>
  <div class="prose">
    <p>
      For corrections, include the article URL, the disputed claim and a primary source supporting
      your proposed change.
    </p>
    <p>
      <a href="https://github.com/GadDev/healthtech-ai-pulse/issues/new">
        Open a public GitHub issue
      </a>
      . GitHub requires an account. Do not submit patient information, private records, credentials
      or confidential material.
    </p>
    <p>This publication does not provide individual medical advice or emergency support.</p>
  </div>
</BaseLayout>
