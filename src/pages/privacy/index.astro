---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Privacy">
  <header class="page-intro">
    <p class="eyebrow">Privacy</p>
    <h1>A small data footprint.</h1>
  </header>
  <div class="prose">
    <p>
      This initial publication has no account system, subscriber database, advertising scripts or
      analytics integration. Site search runs in your browser using a static search index.
    </p>
    <p>
      Hosting and linked services may process ordinary connection information under their own
      policies. Public GitHub issues are managed by GitHub; do not submit personal medical or
      confidential information.
    </p>
    <p>We will update this page before introducing any new data-collection feature.</p>
  </div>
</BaseLayout>
