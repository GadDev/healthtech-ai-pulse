---
import { getCollection } from 'astro:content';
import IllustrationCaption from '../components/IllustrationCaption.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import EvidenceSummary from '../components/EvidenceSummary.astro';
import StoryList from '../components/StoryList.astro';
import { desks, deskKeys } from '../lib/categories';
import { newestEditionFirst } from '../lib/edition';
const stories = (await getCollection('stories', ({ data }) => !data.draft)).sort(
  newestEditionFirst,
);
const [lead, ...remaining] = stories;
---

<BaseLayout>
  {lead ? (
    <>
      <div class="section-rule">
        <span>The latest signal · {desks[lead.data.category].title}</span>
        <time datetime={lead.data.date.toISOString().slice(0, 10)}>
          Edition date{' '}
          {lead.data.date.toLocaleDateString('en-GB', {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
            timeZone: 'UTC',
          })}
        </time>
        {lead.data.edition === 'evening' && ' · Evening edition'}
      </div>
      <article class="lead-story" data-pagefind-body>
        <div class="lead-story__copy">
          <p class="eyebrow">Evidence briefing · {desks[lead.data.category].title}</p>
          <h1>
            <a href={`/stories/${lead.id}/`}>{lead.data.title}</a>
          </h1>
          <p class="lead-story__description">{lead.data.description}</p>
          <a class="text-link" href={`/stories/${lead.id}/`}>
            Read the analysis <span aria-hidden="true">→</span>
          </a>
        </div>
        {lead.data.illustration.mode === 'generated' && (
          <figure class="editorial-image lead-story__image">
            <img
              src={lead.data.illustration.image}
              alt={lead.data.illustration.alt}
              width="1536"
              height="1024"
              fetchpriority="high"
            />
            <IllustrationCaption compact />
          </figure>
        )}
      </article>
      <div class="home-secondary">
        <div>
          <p class="eyebrow">What the evidence supports</p>
          <h2>Read the finding in its setting.</h2>
          <p>{lead.data.evidence.applicability}</p>
        </div>
        <div>
          <p class="eyebrow">Explore the five desks</p>
          <nav class="desk-links" aria-label="Editorial desks">
            {deskKeys.map((key) => (
              <a href={`/desks/${key}/`}>
                {desks[key].title} <span aria-hidden="true">↗</span>
              </a>
            ))}
          </nav>
        </div>
      </div>
      <EvidenceSummary story={lead} compact />
    </>
  ) : (
    <section class="empty-home">
      <p class="eyebrow">Independent perspective · International evidence</p>
      <h1>Evidence before claims.</h1>
      <p class="lede">
        The first edition is taking shape. We publish only when a story clears the evidence and
        editorial gates.
      </p>
      <a class="text-link" href="/methodology/">
        How we work →
      </a>
    </section>
  )}
  {remaining.length > 0 && (
    <section class="more-stories" aria-labelledby="more-stories">
      <div class="section-rule">
        <h2 id="more-stories">More coverage</h2>
      </div>
      <StoryList stories={remaining} showImage />
    </section>
  )}
</BaseLayout>
