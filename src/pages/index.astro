---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryList from '../components/StoryList.astro';
import { desks, deskKeys } from '../lib/categories';
const stories = (await getCollection('stories', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout>
  <section class="hero">
    <p class="eyebrow">
      <span class="signal-mark" aria-hidden="true"></span> Healthcare · AI · Pharma
    </p>
    <h1>Progress deserves a closer look.</h1>
    <p class="lede">What changed. What the evidence supports. What to investigate next.</p>
    <p class="fineprint">
      Independent intelligence for people building and evaluating healthcare AI. European
      perspective, international evidence.
    </p>
  </section>
  <section aria-labelledby="latest">
    <div class="section-top">
      <h2 id="latest">The latest signals</h2>
      <a href="/methodology/">How we assess evidence →</a>
    </div>
    {stories.length ? (
      <StoryList stories={stories} />
    ) : (
      <div class="empty-state">
        <h2>The first edition is taking shape.</h2>
        <p>
          No articles have been published yet. Every story will pair its central claim with the
          evidence, the limitations and the practical consequence. Quiet days are part of the
          promise.
        </p>
      </div>
    )}
  </section>
  <section aria-labelledby="desks">
    <div class="section-top">
      <h2 id="desks">Five desks. One evidence standard.</h2>
    </div>
    <div class="desk-grid">
      {deskKeys.map((key, i) => (
        <article class="desk-tile">
          <span class="story-meta">0{i + 1}</span>
          <h3>
            <a href={`/desks/${key}/`}>{desks[key].title}</a>
          </h3>
          <p>{desks[key].description}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
