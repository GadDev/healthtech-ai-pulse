import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="About">
  <p class="eyebrow">The publication</p>
  <h1>A closer look at healthcare AI.</h1>
  <div class="prose">
    <p>
      HealthTech AI Pulse helps technical product leads, engineers, translational researchers and
      clinical innovation teams understand meaningful developments in healthcare and pharmaceutical
      AI.
    </p>
    <p>
      We ask what changed, what the evidence supports and what deserves investigation next. We lead
      with European relevance and examine international evidence in its original setting.
    </p>
    <p>
      AI is our organising focus. Non-AI developments belong only when they materially affect
      evidence, safety, data access or operating conditions for the workflows we cover.
    </p>
    <p>
      The repository maintainer is the accountable editor. Automation may assist research and
      drafting; human review and merge control publication.
    </p>
    <p>
      <a href="/methodology/">Read our evidence and corrections policy.</a>
    </p>
  </div>
</BaseLayout>
