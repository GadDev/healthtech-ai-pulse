---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { desks, deskKeys } from '../../lib/categories';
---

<BaseLayout title="Editorial desks">
  <header class="page-intro">
    <p class="eyebrow">Coverage · Five editorial desks</p>
    <h1>
      Follow the question,
      <br />
      not the hype.
    </h1>
    <p class="lede">
      Five ways into healthcare AI. No quota to fill, no story duplicated across desks.
    </p>
  </header>
  <section aria-label="Editorial categories" class="category-list">
    {deskKeys.map((key, index) => (
      <article class="category-row">
        <span class="desk-number">0{index + 1}</span>
        <div>
          <h2>
            <a href={`/desks/${key}/`}>
              {desks[key].title}
              <span aria-hidden="true"> ↗</span>
            </a>
          </h2>
          <p>{desks[key].description}</p>
        </div>
      </article>
    ))}
  </section>
  <p class="category-footnote">
    Our <a href="/methodology/">methodology</a> applies across all five desks.
  </p>
</BaseLayout>
