---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryList from '../../components/StoryList.astro';
import { deskKeys, desks, type Desk } from '../../lib/categories';
export function getStaticPaths() {
  return deskKeys.map((desk) => ({ params: { desk } }));
}
const desk = Astro.params.desk as Desk;
const stories = (
  await getCollection('stories', ({ data }) => !data.draft && data.category === desk)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title={desks[desk].title}>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/categories/">Categories</a>
    <span aria-hidden="true"> / </span>
    <span aria-current="page">{desks[desk].title}</span>
  </nav>
  <header class="page-intro desk-intro">
    <p class="eyebrow">Editorial desk</p>
    <h1>{desks[desk].title}</h1>
    <p class="lede">{desks[desk].description}</p>
  </header>
  <section aria-labelledby="desk-stories" class="desk-stories">
    <div class="section-top">
      <h2 id="desk-stories">{stories.length ? 'Latest in this desk' : 'From this desk'}</h2>
      <a href="/methodology/">
        How we assess evidence <span aria-hidden="true">↗</span>
      </a>
    </div>
    {stories.length ? (
      <StoryList stories={stories} showImage />
    ) : (
      <div class="empty-state">
        <h2>No published stories yet.</h2>
        <p>We will publish here when a development clears the evidence and editorial gates.</p>
      </div>
    )}
  </section>
  <nav class="back-link" aria-label="Other categories">
    <a href="/categories/">← Browse all categories</a>
  </nav>
</BaseLayout>
