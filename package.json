{
  "name": "healthtech-ai-pulse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "content:check": "node scripts/validate-content.mjs",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "build": "npm run check && astro build && pagefind --site dist",
    "verify": "npm run lint && npm run format:check && npm run schema:check && npm run content:check && npm run editorial:check && npm run illustration:check && npm test && npm run build",
    "test:e2e": "playwright test",
    "preview": "astro preview",
    "editorial:check": "node scripts/validate-editorial-batch.mjs",
    "illustration:check": "node scripts/validate-illustration-batch.mjs",
    "schema:generate": "node scripts/generate-editorial-schema.mjs",
    "schema:check": "node scripts/generate-editorial-schema.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "deploy:check": "node scripts/validate-deployment.mjs",
    "orchestration:trial": "node --test tests/orchestration.test.mjs",
    "illustration:decision": "node scripts/resolve-illustration-generation.mjs",
    "illustration:contact-sheet": "node scripts/build-illustration-contact-sheet.mjs",
    "illustration:contact-sheet:test": "node --test tests/browser/illustration-contact-sheet.test.mjs",
    "lint:fix": "oxlint --fix --deny-warnings ."
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/sitemap": "3.7.4",
    "astro": "^7.4.0",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "0.5.1",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "pagefind": "1.5.2"
  }
}
